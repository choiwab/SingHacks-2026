digraph RMIntelligenceNodeFlow {
  graph [
    rankdir=TB,
    bgcolor="white",
    pad="0.3",
    nodesep="0.35",
    ranksep="0.55",
    splines=polyline,
    fontname="Arial",
    fontsize=20,
    label="Client Future Room — planned node flow",
    labelloc=t,
    labeljust=l
  ];

  node [
    shape=box,
    style="rounded,filled",
    fontname="Arial",
    fontsize=11,
    fontcolor="#242424",
    color="#605E5C",
    fillcolor="#FFFFFF",
    margin="0.16,0.11"
  ];

  edge [
    color="#605E5C",
    fontcolor="#424242",
    fontname="Arial",
    fontsize=9,
    arrowsize=0.72
  ];

  trigger [
    label="Client selected or data updated\ncurated bundle • facts • signals — Members 3 + 4",
    fillcolor="#F3F2F1"
  ];

  context [
    label="1  Context Agent — Member 2\nload curated inputs • scope and index memory\noutput: validated context + processing mode",
    fillcolor="#E7F4E4",
    color="#107C10"
  ];

  intelligence [
    label="2  Wealth Intelligence Agent — Member 2\nselect precomputed signals and scores\nconnect facts to retrieved client statements\noutput: cited insights",
    fillcolor="#F3E8FF",
    color="#8764B8"
  ];

  briefing [
    label="3  RM Briefing Agent — Member 2\nreuse unchanged memory sections\ncreate summary • talking points • questions\noutput: versioned brief + Memory Card",
    fillcolor="#F3E8FF",
    color="#8764B8"
  ];

  gate [
    label="Evidence Gate — Member 4\ncitations • math • as-of dates • confidence\noutput: VerificationReport",
    fillcolor="#FFF4CE",
    color="#986F0B"
  ];

  review [
    label="Joint meeting-pack review — Member 2\nRM approves • edits • rejects • flags\nMember 3 persists review events",
    fillcolor="#FDE7E9",
    color="#C50F1F"
  ];

  dashboard [
    label="React + Fluent UI dashboard — Member 1\nmeeting brief • insights • data • memory\nevidence drawer • client switcher • compact calendar",
    fillcolor="#E8F3FF",
    color="#0F6CBD"
  ];

  reuse [
    label="No material change\nreuse content and actual review status",
    fillcolor="#F3F2F1"
  ];

  confirm [
    label="Needs confirmation\nshow missing, conflicting, or unsupported evidence",
    fillcolor="#FDE7E9",
    color="#C50F1F"
  ];

  memory [
    label="Communication fixtures — Member 2\nemail • Teams • notes • calendar\nsynthetic provenance • local TF-IDF retrieval",
    fillcolor="#E7F4E4",
    color="#107C10"
  ];

  store [
    label="Persistence + API + view model — Member 3\nteam integration boundary",
    fillcolor="#F3F2F1"
  ];

  reject [label="Record rejection and stop", fillcolor="#FDE7E9"];

  trigger -> context;
  memory -> context;
  context -> intelligence [label="first seen / changed"];
  intelligence -> briefing;
  briefing -> gate;
  gate -> review [label="pass"];
  review -> store [label="approved pack"];
  store -> dashboard;

  context -> reuse [label="unchanged"];
  reuse -> store [label="terminal status"];
  reuse -> review [label="pending review", style=dashed, constraint=false];
  context -> confirm [label="invalid required input"];
  gate -> confirm [label="fail"];
  review -> confirm [label="correction flag"];
  review -> reject [label="reject"];
  review -> gate [label="edit + recheck", style=dashed, constraint=false];
}
