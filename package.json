{
  "name": "singhacks-monday-brief",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,red \"uv run uvicorn app.main:app --reload --port 8000\" \"vite --config frontend/vite.config.ts\"",
    "build": "tsc -b frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "lint": "eslint frontend --max-warnings 0",
    "format": "pnpm format:check",
    "format:check": "prettier --check package.json eslint.config.js playwright.config.ts frontend",
    "format:write": "prettier --write package.json eslint.config.js playwright.config.ts frontend",
    "typecheck": "pnpm typecheck:python && pnpm typecheck:frontend",
    "typecheck:python": "pyright",
    "typecheck:frontend": "tsc -b frontend/tsconfig.json --pretty false",
    "test": "vitest run --config frontend/vite.config.ts",
    "test:watch": "vitest --config frontend/vite.config.ts",
    "test:e2e": "playwright test",
    "export:openapi": "uv run python -m scripts.export_openapi --output .generated/openapi.json",
    "generate:api": "pnpm export:openapi && openapi-typescript .generated/openapi.json -o frontend/src/generated/openapi.ts",
    "check:contract": "uv run python -m scripts.check_contract",
    "dev:preview": "vite --config frontend/vite.config.ts --mode preview",
    "build:preview": "tsc -b frontend/tsconfig.json && vite build --config frontend/vite.config.ts --mode preview",
    "preview": "vite preview --config frontend/vite.config.ts --mode preview"
    "pipeline:run": "uv run python -m app.pipeline run",
    "pipeline:seed": "uv run python -m app.pipeline seed",
    "pipeline:update": "uv run python -m app.pipeline update",
    "pipeline:reset": "uv run python -m app.pipeline reset",
    "pipeline:diff": "uv run python -m app.pipeline diff"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.74.7",
    "@fluentui/react-icons": "^2.0.339",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript-eslint/parser": "^8.69.0",
    "@typescript/native": "npm:typescript@^7.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.0",
    "pyright": "^1.1.413",
    "typescript": "npm:@typescript/typescript6@^6.0.0",
    "vite": "^8.2.0",
    "vitest": "^5.0.0"
  }
}
