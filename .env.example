# Offline execution is the default. These are read only in explicit live mode.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional read-only Google / Outlook connectors. No Teams permission is requested.
# Keep the downloaded Google Desktop OAuth client JSON under Git-ignored .local/.
GOOGLE_OAUTH_CLIENT_FILE=.local/google-client.json
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
